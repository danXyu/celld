---
import Default from '@astrojs/starlight/components/Footer.astro';
---
<Default />
<p class="site-notice">
  Documentation for <a href="https://github.com/ewhauser/celld">ewhauser/celld</a>.
  For the runtime and platform APIs, read the <a href="https://celld.dev/docs/">upstream documentation</a>.
  <small>This is an independent fork, not affiliated with or endorsed by the upstream celld project or Deno Land Inc.</small>
</p>
<style>
  .site-notice { margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--sl-color-hairline); font-size: var(--sl-text-xs); color: var(--sl-color-gray-3); }
  .site-notice small { display: block; margin-top: 0.5rem; font-size: inherit; }
</style>
