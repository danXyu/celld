{
  "backends": [
    "s3"
  ],
  "network": true,
  "nodes": 3,
  "name": "N4-isolated-owner",
  "description": "Node 1 loses every link, to its peers and to the bucket, while it keeps running: a network partition, not a crash. It must fence itself, and the other nodes must take its cells over only once its lease has lapsed. The first phase cuts the links silently (blackhole), the second refuses them (reject); node 1 returns on a healed network after each.",
  "setup": [
    {
      "step": "net",
      "from": "nodes",
      "to": "bucket",
      "both": true,
      "delay_ms": 10,
      "jitter_ms": 5
    },
    {
      "step": "touch",
      "request": {
        "path": "/do/write",
        "query": {
          "bytes": "100"
        },
        "counts_write": true
      },
      "cells": {
        "count": 600,
        "prefix": "iso"
      },
      "concurrency": 16
    }
  ],
  "phases": [
    {
      "name": "isolated-blackhole",
      "duration_s": 70,
      "rate": 150,
      "timeout_ms": 60000,
      "load": [
        {
          "request": {
            "path": "/do/write",
            "query": {
              "bytes": "100"
            },
            "counts_write": true
          },
          "cells": {
            "count": 600,
            "prefix": "iso"
          },
          "node": 0
        }
      ],
      "during": [
        {
          "at_s": 10,
          "step": "net",
          "from": "node:1",
          "to": "any",
          "both": true,
          "partition": "blackhole"
        },
        {
          "at_s": 11,
          "step": "await_exit",
          "node": 1,
          "timeout_s": 45
        },
        {
          "at_s": 45,
          "step": "net_clear"
        },
        {
          "at_s": 46,
          "step": "net",
          "from": "nodes",
          "to": "bucket",
          "both": true,
          "delay_ms": 10,
          "jitter_ms": 5
        },
        {
          "at_s": 47,
          "step": "start",
          "node": 1
        }
      ]
    },
    {
      "name": "isolated-reject",
      "duration_s": 70,
      "rate": 150,
      "timeout_ms": 60000,
      "load": [
        {
          "request": {
            "path": "/do/write",
            "query": {
              "bytes": "100"
            },
            "counts_write": true
          },
          "cells": {
            "count": 600,
            "prefix": "iso"
          },
          "node": 0
        }
      ],
      "during": [
        {
          "at_s": 10,
          "step": "net",
          "from": "node:1",
          "to": "any",
          "both": true,
          "partition": "reject"
        },
        {
          "at_s": 11,
          "step": "await_exit",
          "node": 1,
          "timeout_s": 45
        },
        {
          "at_s": 45,
          "step": "net_clear"
        },
        {
          "at_s": 46,
          "step": "net",
          "from": "nodes",
          "to": "bucket",
          "both": true,
          "delay_ms": 10,
          "jitter_ms": 5
        },
        {
          "at_s": 47,
          "step": "start",
          "node": 1
        }
      ]
    }
  ]
}
