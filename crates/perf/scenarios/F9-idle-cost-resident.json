{
  "backends": [
    "s3"
  ],
  "name": "F9-idle-cost-resident",
  "nodes": 3,
  "description": "F9 with 10,000 resident cells: a resident cell should cost no bucket request while idle.",
  "setup": [
    {
      "step": "touch",
      "request": {
        "path": "/do/write",
        "query": {
          "bytes": "10"
        },
        "counts_write": true
      },
      "cells": {
        "count": 10000,
        "prefix": "idle"
      },
      "concurrency": 16
    }
  ],
  "phases": [
    {
      "name": "idle",
      "before": [
        {
          "step": "sleep",
          "ms": 30000
        }
      ],
      "duration_s": 120,
      "rate": 1,
      "load": [
        {
          "request": {
            "path": "/noop"
          }
        }
      ],
      "checks": [
        {
          "metric": "bucket:class=cell_owner+cell_data",
          "per_second": true,
          "max": 1
        }
      ]
    }
  ]
}
