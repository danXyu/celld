{
  "name": "S15-soak",
  "heavy": true,
  "description": "24 hours of mixed traffic at a moderate rate: RSS, descriptor, local-cache, and object growth, and p99 drift. Compare the first and last hour's phases.",
  "env": {
    "CELLD_PERF_BUCKET_FAULTS": "read=15,write=30,list=20,tail=10",
    "CELLD_MAX_RESIDENT_CELLS": "5000"
  },
  "setup": [
    {
      "step": "touch",
      "request": {
        "path": "/do/write",
        "query": {
          "bytes": "100"
        },
        "counts_write": true
      },
      "cells": {
        "count": 20000,
        "prefix": "soak"
      },
      "concurrency": 16
    }
  ],
  "phases": [
    {
      "name": "hour-00",
      "duration_s": 3600,
      "rate": 300,
      "load": [
        {
          "request": {
            "path": "/do/read"
          },
          "cells": {
            "count": 20000,
            "prefix": "soak",
            "distribution": "shifting",
            "window": 4000,
            "shift_per_s": 2
          },
          "weight": 6
        },
        {
          "request": {
            "path": "/do/write",
            "query": {
              "bytes": "200"
            },
            "counts_write": true
          },
          "cells": {
            "count": 20000,
            "prefix": "soak",
            "distribution": "shifting",
            "window": 4000,
            "shift_per_s": 2
          },
          "weight": 3
        },
        {
          "request": {
            "path": "/noop"
          }
        }
      ],
      "checks": [
        {
          "metric": "client:error_rate",
          "max": 0.001
        }
      ]
    },
